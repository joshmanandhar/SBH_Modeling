citHeader('To cite SBHModeling in use:')

title <- '{SBHModeling}: SBH Modeling of Mortality Rate Estimates'
url <- 'https://joshmanandhar.github.io/SBH_Modeling'
year <- {2026}
note <- sprintf('R Package version %s', meta$Version)

bibentry(
  bibtype = 'Manual',
  title = title,
  author = c(person('Josh', 'Manandhar')),
  year = year,
  note = note,
  url = url,
  textVersion = paste0(
    'Josh Manandhar, (', year, '). ', title, ', ', note, ', ', url
  )
)
